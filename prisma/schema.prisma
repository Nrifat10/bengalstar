generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model WorkerRequest {
  id         String   @id @default(cuid())
  name       String
  company    String?
  phone      String
  city       String
  workerType String
  message    String?
  lang       String   @default("en")
  status     String   @default("new")
  createdAt  DateTime @default(now())
}
