# Prisma database URL.
# Local dev: a SQLite file relative to prisma/ (created by `bun run db:push`).
DATABASE_URL=file:./dev.db

# Production (Vercel): set this in the Vercel project settings → Environment Variables.
# SQLite files on Vercel are read-only at runtime, so for persistent lead storage
# use a hosted DB. Recommended options:
#   • Turso (libSQL, SQLite-compatible):  DATABASE_URL=libsql://<your-db>.turso.io
#                                         DATABASE_AUTH_TOKEN=<token>
#   • Neon (Postgres):                    DATABASE_URL=postgres://...   (also switch
#                                         provider to "postgresql" in prisma/schema.prisma)
# If DATABASE_URL is unset or unreachable on Vercel, the /api/requests route
# automatically falls back to a WhatsApp deep-link so no lead is ever lost.
